__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
docs/credentials/

# Licensed audio kit: Mixkit free license allows use inside rendered video
# but not redistribution of standalone audio files -- these repos are
# public, so the mp3s stay local-only (see assets/audio/ATTRIBUTION.md).
assets/audio/**/*.mp3
# Reel render intermediates (QA frame dumps, pre-mux video)
**/qa/
*.silent.mp4
# Blender character-frame intermediates (regenerable from income-engine/blender_studio/scenes/reels/)
**/frames/

# Licensed stock video (Pexels): usable inside rendered posts, not
# redistributable standalone -- public repo, so raw clips stay local-only
# (see assets/video/ATTRIBUTION.md). Same pattern as assets/audio.
assets/video/**/*.mp4
